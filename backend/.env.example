APP_NAME=VeriSphere
APP_ENV=development
HOST=127.0.0.1
PORT=8088
DEBUG=true
WORKERS_COUNT=1
DATABASE_URL=sqlite+aiosqlite:///./verisphere.db
SECRET_KEY=development-only-change-this-verisphere-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5176,http://127.0.0.1:5176

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Configure either or both providers. Groq is tried first, then Gemini.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

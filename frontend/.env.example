# Defaults to the same-origin API proxy configured in nginx.conf.
VITE_API_URL=/api/v1

# If the API is hosted on a separate domain, use its HTTPS API base:
# VITE_API_URL=https://verisphere-api.hacksmiths.dev/api/v1

# if running the API locally, use the following:
# VITE_API_URL=http://127.0.0.1:8088/api/v1


VITE_APP_NAME=VeriSphere
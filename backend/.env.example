# --- Server Runtime ---
# Pulling these into main.py via settings.HOST/PORT
HOST=your_host_here
PORT=your_port_here
DEBUG=True
WORKERS_COUNT=4

# --- Frontend Access ---
# Used for URL generation in emails (Verify, Reset, Dashboard)
BACKEND_CORS_ORIGINS=["*"]

# --- Core Security ---
# Generate a real key using: openssl rand -hex 32
SECRET_KEY=2a97692dfc0b502b9332763e180a3d414a9a063129054fb33344fc1d0884493d
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for development

# --- Database & Cache ---
# Using asyncpg driver for PostgreSQL
DATABASE_URL=postgresql+asyncpg://<your_database_username_here>:<your_database_password_here>@localhost:5432/<your_database_name_here>
REDIS_URL=redis://localhost:6379/0

# --- AI Infrastructure ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- SMTP / Email Logic ---
# These must match app/workers/tasks/email/__init__.py
MAIL_USERNAME=your_email_here
MAIL_PASSWORD=your_email_password_here
MAIL_FROM=your_email_here
MAIL_FROM_NAME=your_email_from_name_here
MAIL_SERVER=your_smtp_server_here
MAIL_PORT=your_mail_port_here
MAIL_USE_TLS=your_mail_use_tls_here
MAIL_USE_SSL=your_mail_use_ssl_here

# --- Admin Monitoring ---
ADMIN_EMAIL=your_admin_email_here
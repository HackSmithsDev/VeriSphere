# Compose runtime configuration. Generate a strong password with:
# openssl rand -hex 32
APP_ENV=production
DEBUG=false
WORKERS_COUNT=1
POSTGRES_USER=verisphere
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_DB=verisphere
DATABASE_URL=postgresql+asyncpg://verisphere:replace-with-generated-password@postgres:5432/verisphere

# Base64-encoded credentials for the named Cloudflare tunnel.
CLOUDFLARED_TUNNEL_TOKEN=
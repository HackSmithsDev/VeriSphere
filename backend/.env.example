# --- Application Identity ---
APP_NAME=VeriSphere
APP_ENV=development

# --- Server Runtime ---
# Set to 0.0.0.0 so Docker and tunnel interfaces can bind cleanly
HOST=0.0.0.0
PORT=8088
DEBUG=true
WORKERS_COUNT=1

# --- CORS & Frontend Domains ---
# Explicit origin list (Required when allow_credentials=True)
BACKEND_CORS_ORIGINS=["https://verisphere.hacksmiths.dev", "http://localhost:5176", "http://127.0.0.1:5176"]

# --- Core Security ---
SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Cache ---
# In Docker, target the container hostnames (postgres, redis)
DATABASE_URL=sqlite+aiosqlite:///./verisphere.db
REDIS_URL=redis://localhost:6379/0

# --- AI Infrastructure & Models ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- SMTP / Transactional Email ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=VeriSphere Official
MAIL_SERVER=smtpout.secureserver.net
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True

# --- LinkedIn OpenID Connect (optional; register the matching redirect URI) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://verisphere-api.hacksmiths.dev/api/v1/student/telemetry/linkedin/callback
LINKEDIN_SCOPES=openid profile

# --- Student invitation links ---
FRONTEND_BASE_URL=https://verisphere.hacksmiths.dev
STUDENT_INVITATION_EXPIRE_HOURS=24

# --- System Admin Bootstrap ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
